rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function tokenOrgId() {
      return request.auth.token.orgId is string && request.auth.token.orgId != ''
        ? request.auth.token.orgId
        : null;
    }

    function userDocOrgId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId != ''
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }

    function userDocRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != ''
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function effectiveOrgId() {
      return userDocOrgId() != null ? userDocOrgId() : tokenOrgId();
    }

    function effectiveRole() {
      return userDocRole() != null
        ? userDocRole()
        : (request.auth.token.role is string && request.auth.token.role != ''
            ? request.auth.token.role
            : null);
    }

    function isOwner() {
      return effectiveRole() == 'owner';
    }

    function belongsToOrg(docOrgId) {
      return isAuthenticated() && effectiveOrgId() == docOrgId;
    }

    function orgScopedRead() {
      return belongsToOrg(resource.data.orgId);
    }

    function orgScopedCreate() {
      return belongsToOrg(request.resource.data.orgId);
    }

    function orgScopedUpdate() {
      return belongsToOrg(resource.data.orgId);
    }

    function orgScopedDelete() {
      return belongsToOrg(resource.data.orgId) && isOwner();
    }

    match /organizations/{orgDocId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.slug is string;
      allow update, delete: if belongsToOrg(orgDocId) && isOwner();
    }

    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || belongsToOrg(resource.data.orgId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        (belongsToOrg(request.resource.data.orgId) && isOwner())
      );
      allow update, delete: if belongsToOrg(resource.data.orgId) && isOwner();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        userId == request.auth.uid || belongsToOrg(resource.data.orgId)
      );
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if belongsToOrg(resource.data.orgId) && isOwner();
    }

    match /auditLogs/{logId} {
      allow read: if belongsToOrg(resource.data.orgId);
      allow create: if isAuthenticated() && (
        belongsToOrg(request.resource.data.orgId) ||
        request.resource.data.actorId == request.auth.uid
      );
      allow update, delete: if false;
    }

    match /customers/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /vehicles/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /vehicleTasks/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /inventoryCategories/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /inventoryItems/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /employees/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /mechanics/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /mechanicSalesRecords/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if orgScopedDelete();
    }

    match /posOrders/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if false;
    }

    match /payrollEntries/{docId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedUpdate();
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if belongsToOrg(resource.data.orgId) && resource.data.userId == request.auth.uid;
      allow create: if orgScopedCreate();
      allow update: if belongsToOrg(resource.data.orgId) && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
