rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function orgId() {
      return request.auth.token.orgId;
    }

    function role() {
      return request.auth.token.role;
    }

    function isOwner() {
      return role() == 'owner';
    }

    function docBelongsToOrg() {
      return isAuthenticated()
        && resource.data.keys().hasAny(['orgId'])
        && resource.data.orgId == orgId();
    }

    function requestBelongsToOrg() {
      return isAuthenticated()
        && request.resource.data.keys().hasAny(['orgId'])
        && request.resource.data.orgId == orgId();
    }

    function isEmployeeOrOwner() {
      return isAuthenticated() && (role() == 'owner' || role() == 'employee');
    }

    match /organizations/{orgDocId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.slug is string;
      allow update, delete: if isAuthenticated() && orgId() == orgDocId && isOwner();
    }

    match /memberships/{membershipId} {
      allow get: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || docBelongsToOrg()
      );
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        (requestBelongsToOrg() && isOwner())
      );
      allow update, delete: if docBelongsToOrg() && isOwner();
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (
        userId == request.auth.uid || docBelongsToOrg()
      );
      allow list: if isAuthenticated();
      allow create, update: if isAuthenticated() && userId == request.auth.uid;
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /auditLogs/{logId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg();
      allow update, delete: if false;
    }

    match /customers/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg();
      allow update: if docBelongsToOrg();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /vehicles/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg();
      allow update: if docBelongsToOrg();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /services/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /vehicleTasks/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isEmployeeOrOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /taskStatusEvents/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if false;
    }

    match /categories/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /products/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isEmployeeOrOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /stockMovements/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update, delete: if false;
    }

    match /suppliers/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isEmployeeOrOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /posSales/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update, delete: if docBelongsToOrg() && isOwner();
    }

    match /posSaleItems/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update, delete: if docBelongsToOrg() && isOwner();
    }

    match /supplierPurchaseEntries/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update, delete: if docBelongsToOrg() && isOwner();
    }

    match /mechanics/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /mechanicLedgerEntries/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update, delete: if docBelongsToOrg() && isOwner();
    }

    match /leaveRequests/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /salaryRecords/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if false;
    }

    match /storeSettings/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if false;
    }

    match /notificationLogs/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    match /notificationTemplates/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isOwner();
      allow update: if docBelongsToOrg() && isOwner();
      allow delete: if false;
    }

    match /whatsappLogs/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /whatsappDedupe/{docId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /drafts/{docId} {
      allow get, list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /serializedItems/{docId} {
      allow get: if docBelongsToOrg();
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isEmployeeOrOwner();
      allow delete: if docBelongsToOrg() && isOwner();
    }

    match /sequences/{seqId} {
      allow get: if isAuthenticated() && (resource == null || docBelongsToOrg());
      allow list: if isAuthenticated();
      allow create: if requestBelongsToOrg() && isEmployeeOrOwner();
      allow update: if docBelongsToOrg() && isEmployeeOrOwner();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
