{
  "name": "big-bull-car-spa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@car-spa/web",
    "dev:emu": "concurrently -k \"npm run emulators\" \"npm run dev\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace=@car-spa/infrastructure",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --import=./firebase/emulator-data --export-on-exit=./firebase/emulator-data",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "sonner": "^2.0.7"
  }
}
