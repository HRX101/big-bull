# =============================================================================
# Big Bull Car Spa — Environment Variables
# Copy this file to apps/web/.env.local and fill in the values.
# =============================================================================

# --- Firebase Web SDK (required) ---
# Get these from Firebase Console → Project Settings → General → Web Apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=big-bull-car-spa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=big-bull-car-spa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=big-bull-car-spa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=931079920842
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase App Check (optional, for production) ---
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- Firebase Emulator Suite (for local development) ---
# Set to true when using firebase emulators:start
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Organization (single-tenant bootstrap) ---
NEXT_PUBLIC_DEFAULT_ORG_NAME=Big Bull Car Spa

# --- WhatsApp Cloud API (Meta) — optional, for customer notifications ---
# Create a WhatsApp Business Account and app at developers.facebook.com
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_ID=vehicle_task_update
