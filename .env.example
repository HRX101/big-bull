# Firebase Web SDK (from existing big-bull-car-spa web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=big-bull-car-spa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=big-bull-car-spa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=big-bull-car-spa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=931079920842
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App Check (optional for local dev — leave site key empty to disable)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Debug token from Firebase Console > App Check > Manage debug tokens
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Emulator hosts (set automatically when using dev:emu)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Canonical app URL for Firebase email action links (optional).
# If unset, the current browser origin is used automatically (localhost, preview URL, production).
# Set this in deployed environments when you need a fixed URL regardless of access domain.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Default organization (Phase 1 single-tenant bootstrap)
NEXT_PUBLIC_DEFAULT_ORG_NAME=Big Bull Car Spa

# Custom claims sync via Cloud Function (requires Blaze plan + deployed function)
# Leave false/unset on Spark — org context is read from Firestore memberships instead.
NEXT_PUBLIC_ENABLE_CLAIMS_SYNC=false
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Firebase Performance (opt-in — Tailwind class names break automatic click traces locally)
NEXT_PUBLIC_ENABLE_FIREBASE_PERFORMANCE=false
