# =============================================================================
# Big Bull Car Spa — Cloud Functions environment
# Copy this file to functions/.env and fill in the values.
# In production, prefer Firebase Functions Config or Secret Manager.
# =============================================================================

# --- WhatsApp Notifications (provider-agnostic) ---
# Which provider is active — the ONLY line to change when switching providers.
WHATSAPP_PROVIDER=none                 # meta | twilio | none

# Meta Cloud API
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_BUSINESS_ACCOUNT_ID=
WHATSAPP_META_API_VERSION=v20.0
WHATSAPP_META_WEBHOOK_VERIFY_TOKEN=

# Twilio
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM_NUMBER=
# Optional pre-approved content template (ContentSid). Leave empty to send free-form Body.
WHATSAPP_TWILIO_CONTENT_SID=

# Shared behavior
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BACKOFF_MS=2000
WHATSAPP_RATE_LIMIT_PER_SECOND=8

# --- Cloud Tasks queue ---
# Queue location must match the functions region (asia-south1).
WHATSAPP_QUEUE_LOCATION=asia-south1
# Keep queueing on Cloud Tasks; set to false to process inline (e.g. emulator).
WHATSAPP_USE_CLOUD_TASKS=true
